# For future local development only. This file is NOT a configured environment.
APP_ENV=development
APP_HTTP_ADDR=127.0.0.1:8080
APP_GRPC_ADDR=127.0.0.1:50051
POSTGRES_DSN=postgres://flrp:REPLACE_ME@postgres:5432/flrp?sslmode=disable
